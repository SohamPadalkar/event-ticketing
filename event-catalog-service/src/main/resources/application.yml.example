server:
  port: 8081

spring:
  application:
    name: event-catalog-service
  threads:
    virtual:
      enabled: true
  datasource:
    url: jdbc:postgresql://YOUR_HOST:5432/postgres?user=YOUR_USER&password=YOUR_PASSWORD&currentSchema=catalog_schema&prepareThreshold=0
    driver-class-name: org.postgresql.Driver
    hikari:
      maximum-pool-size: 5
      connection-timeout: 20000
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        default_schema: catalog_schema